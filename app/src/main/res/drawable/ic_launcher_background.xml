<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标背景层（日间）：108×108 满幅 + 斜向线性渐变 #4FA3FF → #0A63E8。
  渐变用 aapt:attr 内联，AAPT2 会抽出合成资源 $ic_launcher_background__0 ——
  与真机版发布包资源表逐字节一致（夜间版见 drawable-night/）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF4FA3FF" />
                <item android:offset="1" android:color="#FF0A63E8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
